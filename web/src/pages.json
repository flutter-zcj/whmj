{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
      "^lg-([^-].*)": "zhpub_ap/login/components/lg-$1/lg-$1.vue",
      "^ol-([^-].*)": "zhpub_com/src/zpub_map/components/ol-$1/ol-$1.vue",
      "^cx2-([^-].*)": "zhpub_com/src/zpub_att/components/cx2-$1/cx2-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue",
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "name": "whmjLogin",
      "path": "pages/whmj/login",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom",
        "h5": {
          "titleNView": false
        }
      }
    },
    {
      "name": "whmjLobby",
      "path": "pages/whmj/index",
      "style": {
        "navigationBarTitleText": "大厅",
        "navigationStyle": "custom"
      }
    },
    {
      "name": "whmjRoom",
      "path": "pages/whmj/room",
      "style": {
        "navigationBarTitleText": "房间",
        "navigationStyle": "custom"
      }
    },
    {
      "name": "whmjTable",
      "path": "pages/whmj/table",
      "style": {
        "navigationBarTitleText": "牌桌",
        "navigationStyle": "custom"
      }
    },
    {
      "name": "gdIndex",
      "path": "pages/gd/index",
      "style": {
        "navigationBarTitleText": "掼蛋",
        "navigationStyle": "custom",
        "h5": {
          "titleNView": false
        },
        "app-plus": {
          "bounce": "none"
        }
      }
    },
    {
      "name": "gdRoom",
      "path": "pages/gd/room",
      "style": {
        "navigationBarTitleText": "掼蛋房间",
        "navigationStyle": "custom",
        "h5": {
          "titleNView": false
        },
        "app-plus": {
          "bounce": "none"
        }
      }
    },
    {
      "name": "gdTable",
      "path": "pages/gd/table",
      "style": {
        "navigationBarTitleText": "掼蛋牌桌",
        "navigationStyle": "custom",
        "h5": {
          "titleNView": false
        },
        "app-plus": {
          "bounce": "none"
        }
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "武汉赖子麻将",
    "navigationBarBackgroundColor": "#1AA86C",
    "backgroundColor": "#F8F8F8",
    "app-plus": {
      "bounce": "none"
    }
  }
}
