[Unit]
Description=Wuhan Laizi Mahjong Server (Go + cherry)
After=network.target

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/whmj-server
EnvironmentFile=/www/wwwroot/whmj-server/etc/whmj.env
ExecStart=/www/wwwroot/whmj-server/whmj -profile etc/whmj.json -node whmj-1 -type whmj -http 127.0.0.1:9110
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
